{
    "name": "turismo/api-waykipromo",
    "description": "API REST BFF de WaykiPromos desarrollada en PHP 8.4+ Puro bajo Clean Architecture",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.4"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "start": "php -S 127.0.0.1:3001 -t public",
        "test": "vendor/bin/phpunit",
        "test:procedures": "php bin/test-procedures.php"
    },
    "config": {
        "process-timeout": 0,
        "optimize-autoloader": true,
        "sort-packages": true
    }
}
