<IfModule mod_rewrite.c>
    RewriteEngine On

    # Bloquear acceso directo a directorios internos del backend
    RewriteRule ^(src|vendor|deploy|database|tests|storage|bin)/ - [F,L]

    # Prevenir bucles de reescritura interna
    RewriteCond %{ENV:REDIRECT_STATUS} 200
    RewriteRule ^ - [L]

    # Redirigir todas las peticiones que no correspondan a archivos existentes a index.php
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ index.php [QSA,L]
</IfModule>

# Seguridad: Bloquear acceso a archivos sensibles y de configuración
<FilesMatch "^(config.*\.php|\.env.*|deploy\.zip|\.ftp-deploy-sync-state\.json|composer\..*|\.git.*)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Bloquear archivos ocultos que empiecen con punto
<FilesMatch "^\.">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
